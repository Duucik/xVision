{
  "name": "hockey-video-analysis-itaa",
  "version": "1.6.0",
  "description": "xVision (оформление ITAA) — хоккейная видеоаналитика: нарезка, теги, разметка, экспорт",
  "author": "Дудин Данила",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "node prepare-build.js && set CSC_IDENTITY_AUTO_DISCOVERY=false&& electron-builder"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "onnxruntime-node": "1.20.1",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.hockeyanalytics.app.itaa",
    "productName": "xVision ITAA",
    "files": [
      "main.js",
      "preload.js",
      "downloader.js",
      "freeze.js",
      "yolox.js",
      "tracker.js",
      "motion.js",
      "ai.js",
      "ai-host.js",
      "seg.js",
      "license-core.js",
      "license.html",
      "license/public.key",
      "Что нового.txt",
      "live.js",
      "vkdvr.js",
      "vendor/hls.min.js",
      "index.html",
      "coach.html",
      "coach-rink.js",
      "coach-print.css",
      "logos/*.png",
      "build/*.png",
      "fonts/*.woff"
    ],
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/**",
      "**/node_modules/onnxruntime-node/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "files": [
        "!**/node_modules/onnxruntime-node/bin/napi-v3/linux/**",
        "!**/node_modules/onnxruntime-node/bin/napi-v3/darwin/**",
        "!**/node_modules/onnxruntime-node/bin/napi-v3/win32/arm64/**"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "xVision ITAA",
      "runAfterFinish": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "installerLanguages": [
        "ru_RU"
      ],
      "language": "1049",
      "artifactName": "xVision-ITAA-Setup-${version}.${ext}",
      "include": "build/installer.nsh",
      "deleteAppDataOnUninstall": false
    },
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "models",
        "to": "models",
        "filter": [
          "*.onnx",
          "*.txt"
        ]
      },
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "yt-dlp.exe",
          "yt-dlp"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Duucik",
        "repo": "xVision",
        "releaseType": "release"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg"
        }
      ],
      "icon": "build/icon-mac.png",
      "category": "public.app-category.sports",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "xVision-ITAA-${version}-${arch}.${ext}",
      "files": [
        "!**/node_modules/onnxruntime-node/bin/napi-v3/linux/**",
        "!**/node_modules/onnxruntime-node/bin/napi-v3/win32/**"
      ],
      "extendInfo": {
        "NSCameraUsageDescription": "Не используется",
        "LSApplicationCategoryType": "public.app-category.sports"
      }
    },
    "dmg": {
      "title": "xVision ITAA ${version}",
      "artifactName": "xVision-ITAA-${version}-${arch}.${ext}"
    },
    "afterSign": "build/mac-adhoc-sign.js"
  },
  "xvProduct": "itaa",
  "repository": "https://github.com/Duucik/xVision"
}
